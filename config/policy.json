{
  "version": 1,
  "control_repository": "alescim17/github-chatops",
  "control_issues": [
    3
  ],
  "authorized_actors": [
    "alescim17"
  ],
  "allowed_repositories": [
    "target/reporelay",
    "target/aether",
    "target/streamforge",
    "target/homeassistant"
  ],
  "merge_methods": [
    "merge",
    "squash",
    "rebase"
  ],
  "allow_auto_merge": false,
  "allow_direct_default_branch_writes": false,
  "allow_force_branch_updates": false,
  "merge": {
    "require_mergeable": true,
    "require_no_changes_requested": true,
    "require_no_unresolved_review_threads": true,
    "require_current_checks_green": true,
    "require_any_check": true
  },
  "limits": {
    "max_atomic_commit_files": 32,
    "max_atomic_commit_bytes": 48000,
    "max_command_bytes": 60000,
    "max_freeze_branches": 8,
    "max_freeze_prs": 8,
    "max_freeze_issues": 8,
    "max_freeze_shas": 8,
    "max_read_result_bytes": 10240,
    "max_file_lines": 120,
    "max_diff_lines": 160,
    "max_comment_items": 20,
    "max_search_results": 20,
    "max_workflow_runs": 30,
    "max_workflow_jobs": 30,
    "max_log_lines": 120,
    "max_read_page": 1000,
    "max_read_page_size": 100,
    "max_read_requests": 160,
    "max_read_source_bytes": 4194304,
    "max_read_timeout_ms": 20000,
    "max_read_ref_bytes": 200,
    "max_read_path_bytes": 512,
    "max_read_path_depth": 16,
    "max_tree_entries": 10000,
    "max_review_threads": 300,
    "max_check_runs": 100,
    "max_commit_statuses": 100,
    "max_branch_items": 50,
    "max_commit_items": 30,
    "max_pr_files": 30,
    "max_artifact_items": 30,
    "max_workflow_steps": 100,
    "max_search_terms": 8,
    "max_search_term_bytes": 80,
    "max_parent_commits": 8,
    "max_public_label_bytes": 160
  }
}
